{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/personal/layout,_N_T_/personal/login/layout,_N_T_/personal/login/page,_N_T_/personal/login"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/personal/login/__PAGE__",
    "/personal/login",
    "/personal",
    "/_index",
    "/_head"
  ]
}